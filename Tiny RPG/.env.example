# Local development defaults. Copy this file to .env only when overriding them.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./tiny_rpg.db
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=development-only-change-this-key-before-any-real-deployment-123456
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@tinyrpg.local
SMTP_STARTTLS=false
