# Supply real values through the deployment platform's secret manager.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://user:password@database.example/tinyrpg
FRONTEND_ORIGINS=https://tinyrpg.example
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters-long
COOKIE_SECURE=true
FRONTEND_URL=https://tinyrpg.example
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-password
SMTP_FROM_EMAIL=no-reply@tinyrpg.example
SMTP_STARTTLS=true
